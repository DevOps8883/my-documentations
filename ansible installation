# How to install ansible on control node
sudo apt update
sudo apt install -y software-properties-common
sudo add-apt-repository --yes --update ppa:ansible/ansible
sudo apt install -y ansible
# ansible --version           ----> on control node
# python3 --version ----> on managed nodes bcos it is required by ansible
# ansible localhost -m ping   ----> on control node. To confirm ansible is installed and working
  mkdir -p ~/ansible
  cd ~/ansible
  vi hosts       ----> on control node. To add all the managed hosts/nodes IP addressess and hostnames
# Edit the details below to the details of your managed servers private IPs and key-pair name
[web]
node-2 ansible_host=172.31.1.100
node-3 ansible_host=172.31.1.101

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/dav.pem

# ansible -i ~/ansible/hosts all -m ping     ----> on control node to check ansible connectivity with the managed nodes
# ansible all --list-hosts  --> on the control node == No hosts
# vi ansible.cfg
[defaults]
inventory = ./hosts

